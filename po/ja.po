#: src/ui/control.rs
msgid "About Ferramari"
msgstr "Ferramari について"

#: src/ui/control.rs
msgid ""
"<span size=\"x-large\"><b>Local Video</b></span>\n"
"Videos located in Ferramari folder"
msgstr ""
"<span size=\"x-large\"><b>ローカル動画</b></span>\n"
"Ferramari フォルダー内の動画"

#: src/ui/control.rs
msgid "Refresh"
msgstr "更新"

#: src/ui/control.rs
msgid "Open Ferramari folder"
msgstr "Ferramari フォルダーを開く"

#: src/ui/control.rs
msgid "Apply"
msgstr "適用"

#: src/ui/control.rs
msgid "Local Video"
msgstr "ローカル動画"

#: src/ui/control.rs
msgid ""
"<span size=\"x-large\"><b>Streaming</b></span>\n"
"Videos from streaming services"
msgstr ""
"<span size=\"x-large\"><b>ストリーミング</b></span>\n"
"ストリーミングサービスの動画"

#: src/ui/control.rs
msgid "<b>Streaming URL</b>"
msgstr "<b>ストリーミング URL</b>"

#: src/ui/control.rs
msgid "💡\tThis feature uses <i>yt-dlp</i> as backend"
msgstr "💡\tこの機能はバックエンドに <i>yt-dlp</i> を使用します"

#: src/ui/control.rs
msgid ""
"😉\tTry playing any YouTube video! <a href=\"https://github.com/yt-dlp/yt-"
"dlp/blob/master/supportedsites.md\">Supported sites (yt-dlp)</a>"
msgstr ""
"😉\tYouTube の動画を再生してみましょう！<a href=\"https://github.com/yt-dlp/"
"yt-dlp/blob/master/supportedsites.md\">対応サイト (yt-dlp)</a>"

#: src/ui/control.rs
msgid "Hint"
msgstr "ヒント"

#: src/ui/control.rs
msgid "Streaming"
msgstr "ストリーミング"

#: src/ui/control.rs
msgid ""
"<span size=\"x-large\"><b>Web Page</b></span>\n"
"Set a web page as wallpaper"
msgstr ""
"<span size=\"x-large\"><b>ウェブページ</b></span>\n"
"ウェブページを壁紙に設定"

#: src/ui/control.rs
msgid "<b>Web Page URL</b>"
msgstr "<b>ウェブページ URL</b>"

#: src/ui/control.rs
msgid ""
"💡\tCheck this website for some really amazing examples!\n"
"\t<a href=\"https://alteredqualia.com/\">https://alteredqualia.com/</a>"
msgstr ""
"💡\tこのウェブサイトで素晴らしい例をチェックしてみましょう！\n"
"\t<a href=\"https://alteredqualia.com/\">https://alteredqualia.com/</a>"

#: src/ui/control.rs
msgid "<b>Local Web Page</b>"
msgstr "<b>ローカルウェブページ</b>"

#: src/ui/control.rs
msgid "Alternately, you can choose a HTML file on your PC"
msgstr "または、PC 上の HTML ファイルを選択することもできます"

#: src/ui/control.rs
msgid "Web Page"
msgstr "ウェブページ"

#: src/ui/control.rs
msgid "Project website"
msgstr "プロジェクトのウェブサイト"

#: src/ui/control.rs
msgid "😉\tTry playing any YouTube video!"
msgstr "😉	YouTube の動画を再生してみましょう！"

