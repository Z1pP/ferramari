<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
  <id>io.github.ferramari.Ferramari</id>
  <name>Ferramari</name>
  <summary>Video wallpaper for Linux</summary>
  <developer id="io.github.ferramari">
    <name>Ferramari contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>Ferramari is a video wallpaper for Linux, written in Rust. 🦀</p>
    <p>Play local videos, streaming URLs or web pages as your desktop
    wallpaper, one source per monitor. It can pause or mute itself when a
    window is maximized, apply a blurred video frame as the GNOME static
    wallpaper, and restore your original background on exit.</p>
  </description>
  <releases>
    <release version="0.2.0" date="2026-10-29" type="stable">
      <description>
        <p>Wallpaper catalogue and previews.</p>
        <ul>
          <li>Browse live wallpapers with categories, search and pagination</li>
          <li>Preview a still and six frames before installing</li>
          <li>Download cache with age and size limits</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-26" type="stable">
      <description>
        <p>First release.</p>
        <ul>
          <li>Local, streaming and web-page wallpapers</li>
          <li>Multi-monitor support with per-monitor sources</li>
          <li>GNOME static wallpaper with blurred video frame</li>
          <li>Pause/mute on maximized or fullscreen windows, screen lock and logout handling</li>
          <li>Tray icon, autostart, D-Bus API and single-instance handling</li>
        </ul>
      </description>
    </release>
  </releases>
  <url type="homepage">https://github.com/ferramari/ferramari</url>
  <url type="bugtracker">https://github.com/ferramari/ferramari/issues</url>
  <categories>
    <category>GTK</category>
    <category>Utility</category>
  </categories>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">io.github.ferramari.Ferramari.desktop</launchable>
  <keywords>
    <keyword>Live Wallpaper</keyword>
    <keyword>Video Wallpaper</keyword>
    <keyword>Wallpaper</keyword>
  </keywords>
</component>